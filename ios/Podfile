# Resolve react_native_pods.rb with node to allow for hoisting
def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

# Use it to require both react-native's and this package's scripts:
node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'Camera',
  'MediaLibrary',
  'PhotoLibrary',
  'Notifications',
])

# React Native Firebase requires frameworks (dynamic via SPM by default on RN 0.75+)
use_frameworks! :linkage => :dynamic

target 'JamatConnect' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Legacy pods that only declare `React-Core` don't link the prebuilt React
    # framework when built as dynamic frameworks, causing undefined RCT* symbols.
    if ENV['RCT_USE_PREBUILT_RNCORE'] == '1'
      installer.pod_targets.each do |pod_target|
        next unless pod_target.build_as_dynamic_framework?
        deps = pod_target.specs.flat_map { |s| s.dependencies(pod_target.platform).map(&:name) }
        next unless deps.include?('React-Core') && !deps.include?('React-Core-prebuilt')

        native_target = installer.pods_project.targets.find { |t| t.name == pod_target.name }
        next unless native_target
        native_target.build_configurations.each do |build_config|
          flags = build_config.build_settings['OTHER_LDFLAGS'] || ['$(inherited)']
          flags = [flags] if flags.is_a?(String)
          build_config.build_settings['OTHER_LDFLAGS'] = flags + ['-framework', 'React']
        end
      end
    end
  end
end
